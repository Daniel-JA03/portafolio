---
import ExperienceItem from "./ExperienceItem.astro"
export const EXPERIENCE = [
  {
    date: "2023 - 2025",
    title: "Egresado en Computación e Informática",
    company: "Cibertec",
    image: "/cibertec2.webp",
    description:
      "Egresado en Computación e Informática con formación en desarrollo de software, bases de datos y aplicaciones web. Experiencia en el desarrollo de APIs REST con Java y Spring Boot, así como con C# y ASP.NET Core Web API. Manejo de tecnologías como MySQL, SQL Server, MongoDB y .NET Framework. Enfoque en la resolución de problemas, aplicación de buenas prácticas de programación y desarrollo de soluciones eficientes.",
  },
  
]
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experiencie) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experiencie} />
      </li>
    ))
  }
</ol>
